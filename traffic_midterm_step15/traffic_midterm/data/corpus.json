  {
    "id": "L93",
    "kind": "law",
    "title": "道路交通安全規則第93條",
    "text": "車速依速限標誌或標線；行經無號誌路口等列舉情況應減速並準備停車。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=93",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
    "id": "L941",
    "kind": "law",
    "title": "道路交通安全規則第94條第1項",
    "text": "同車道前後行駛，除擬超車外，後車須保留可隨時煞停的距離。追撞爭議須核對安全距離與前車動態。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=94",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
    "id": "L943",
    "kind": "law",
    "title": "道路交通安全規則第94條第3項",
    "text": "行駛中須留意車前狀況與並行間隔，採取必要安全措施。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=94",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
    "id": "L98",
    "kind": "law",
    "title": "道路交通安全規則第98條第1項第6款",
    "text": "同向多車道路段變換車道，須禮讓直行車並維持安全距離。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=98",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
    "id": "L1021",
    "kind": "law",
    "title": "道路交通安全規則第102條第1項第1款",
    "text": "交岔路口依交通號誌與指揮行進；兩者並用時以交通指揮為準。闖紅燈主張須有本案號誌證據。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=102",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
    "id": "L1022",
    "kind": "law",
    "title": "道路交通安全規則第102條第1項第2款",
    "text": "無號誌且無交通指揮的路口，依幹支線、車道數及行進方向等順序判斷讓行；須確認適用條件。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=102",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
    "id": "L1027",
    "kind": "law",
    "title": "道路交通安全規則第102條第1項第7款",
    "text": "交岔路口轉彎車須禮讓直行車，仍須核對號誌、動向和雙方其他行為。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=102",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
    "id": "L112",
    "kind": "law",
    "title": "道路交通安全規則第112條第5項",
    "text": "臨停或停車開關車門時，須留意其他用路人並讓其先行，確認安全後開門。",
    "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=K0040013&flno=112",
    "accessed": "2026-10-18",
    "content_type": "curated_paraphrase_not_verbatim",
    "temporal_scope": "current_on_access_date_not_accident_date",
    "review_status": "primary_source_consulted_not_independent_legal_review"
  },
  {
